# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Credentials (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Dashboard Access
ADMIN_PASSWORD=change-me-to-a-secure-password

# Session Secret (min 32 characters for HMAC-SHA256)
SESSION_SECRET=super-secret-subject-zero-key-32-characters-minimum

# Event Mode: "onsite" (venue shared IP, ~100 players) | "remote" (home networks, stricter IP limits)
EVENT_MODE=onsite

# Optional Rate Limit Overrides (defaults configured automatically based on EVENT_MODE)
# RATE_LIMIT_ANSWERS_PER_IP=600
# RATE_LIMIT_JOIN_PER_IP=300
# RATE_LIMIT_LEADERBOARD_PER_IP=600
# RATE_LIMIT_STATE_PER_IP=1200
